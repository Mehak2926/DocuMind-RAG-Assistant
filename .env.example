# Copy this file to .env and paste your Groq key.
GROQ_API_KEY=gsk_your_key_here

# Current production default on GroqCloud.
GROQ_MODEL=llama-3.3-70b-versatile

# Free, local embedding model downloaded on first run.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

CHROMA_DIR=data/chroma_db
COLLECTION_NAME=document_qa
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=5
MIN_RELEVANCE=0.35
